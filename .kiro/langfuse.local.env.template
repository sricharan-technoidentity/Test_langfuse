# Langfuse Local Configuration Template
# Copy this to .kiro/langfuse.local.env and fill in your values
# DO NOT commit .kiro/langfuse.local.env (it contains secrets)

# REQUIRED: Enable tracing (credentials alone do NOT enable tracing)
TRACE_TO_LANGFUSE=true

# REQUIRED: API credentials from Langfuse project settings
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here

# REQUIRED: Langfuse server URL (default is localhost for self-hosted)
# For self-hosted: http://127.0.0.1:3000 (or your server URL)
# For EU cloud: https://cloud.langfuse.com
# For US cloud: https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=http://127.0.0.1:3000

# OPTIONAL: Debug mode (logs to stderr and .kiro/langfuse-state-local/errors.log)
# KIRO_LF_DEBUG=1
