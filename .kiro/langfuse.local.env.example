# Kiro Langfuse local configuration
# Copy this to langfuse.local.env and fill in your credentials
# IMPORTANT: langfuse.local.env is gitignored and should have mode 600

# Enable tracing (set to "true" to activate)
TRACE_TO_LANGFUSE=true

# Langfuse endpoint (local self-hosted instance)
LANGFUSE_BASE_URL=http://127.0.0.1:3000

# API credentials from your Langfuse project settings
# These are placeholders - replace with real values
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
