{
  "$schema": "objective-checks-schema.json",
  "$comment": "Task3 objective check commands for this Python repo. Run after workflow completion.",
  
  "build_pass": {
    "command": "python3 -m py_compile .kiro/hooks/langfuse_kiro_hook.py .kiro/hooks/tracing_context.py .kiro/hooks/objective_scores.py .kiro/hooks/langfuse_scores.py .kiro/hooks/dashboard_config.py",
    "description": "Compile all hook Python modules to check for syntax errors",
    "timeout_seconds": 30,
    "enabled": true
  },
  
  "test_pass": {
    "command": "python3 -m pytest tests/ -v --tb=short -q",
    "description": "Run all pytest tests in the tests/ directory",
    "timeout_seconds": 120,
    "enabled": true
  },
  
  "lint_clean": {
    "command": "python3 -m py_compile .kiro/hooks/*.py && echo 'Syntax OK'",
    "description": "Check Python syntax (no external linter installed). For proper linting, install ruff or flake8.",
    "timeout_seconds": 30,
    "enabled": true,
    "$note": "This is a minimal check. For production, use: python3 -m ruff check .kiro/hooks/ --select=E,F,W"
  }
}
